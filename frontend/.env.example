BACKEND_URL=http://127.0.0.1:8000
# Staging: https://<render-backend-host> (server-only; no NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_APP_NAME=Generate Description AI

# Server-only Google OAuth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Staging: https://<staging-frontend-host>/api/auth/google/callback

# Public HTTPS origin used only by server-generated SEO metadata (no trailing path).
# Set for staging too. Unset/invalid values omit canonical and sitemap URLs.
# Existing mechanism: SITE_URL=https://<staging-frontend-host>.
# NEXT_PUBLIC_SITE_URL is not consumed by this app; use SITE_URL instead.
SITE_URL=

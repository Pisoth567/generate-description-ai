APP_NAME=Generate Description AI API
APP_ENV=development
# Staging: APP_ENV=staging and FRONTEND_URL=https://<staging-frontend-host>
# One origin only; local development keeps http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# Generate a unique staging secret of at least 32 bytes; enter it in Render only.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_TIMEOUT_SECONDS=30
GENERATION_CREDIT_COST=1
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/DATABASE_NAME
# Staging: use Render's Internal Database URL. postgresql:// is also accepted.

PAYWAY_MERCHANT_ID=
# PAYWAY_API_KEY is the PayWay signing credential used by Purchase and Check Transaction.
# The sandbox credential package may label this value as Public Key. Keep it secret and server-side.
PAYWAY_API_KEY=
PAYWAY_ENV=sandbox
PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh
# Optional for manual QR verification. Leave empty; callback verification is disabled.
PAYWAY_RETURN_URL=
PAYWAY_CONTINUE_SUCCESS_URL=
PAYWAY_CANCEL_URL=
PAYWAY_TIMEOUT_SECONDS=15

# Same OAuth web client ID configured on the staging frontend.
GOOGLE_CLIENT_ID=

# Phase 1: paid product features are disabled; leave false.
PAYMENTS_ENABLED=false
GENERATION_RATE_LIMIT_PER_MINUTE=5
GENERATION_RATE_LIMIT_PER_DAY=50
# Transactional email: set provider to resend only after configuring a verified sender.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
# Dedicated independent random secret, at least 32 bytes. Never use the JWT secret.
EMAIL_VERIFICATION_SECRET=
